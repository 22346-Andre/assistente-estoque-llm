# Copie este arquivo para .env e preencha. NUNCA suba o .env para o GitHub.

# Provedor do LLM: "anthropic" (pago) ou "ollama" (local e gratuito)
LLM_PROVIDER=ollama

# --- Ollama (modelo local, gratuito) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Anthropic (precisa de saldo na conta) ---
ANTHROPIC_API_KEY=coloque_sua_chave_aqui
ANTHROPIC_MODEL=claude-sonnet-5-5

# Caminho do banco SQLite de demonstração
DB_PATH=data/estoque.db
